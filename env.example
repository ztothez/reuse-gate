# Copy to .env and fill in. Never commit .env or any key.
# Live backends are gpt-oss-120b on Aitta, then GLM-5.2 on Featherless. Set LLM_MODE=rules to turn models off.
LLM_MAX_CALLS=100
# Optional limits: seconds per primary call, seconds per fallback call, seconds of model time per request, model calls at once.
# LLM_TIMEOUT=20
# LLM_FALLBACK_TIMEOUT=40
# LLM_REQUEST_DEADLINE=60
# LLM_MAX_CONCURRENT=4
# Shared secret for /n8n/* endpoints. n8n_API_KEY is also accepted.
N8N_API_KEY=
# Primary live backend, evaluation and embedding KPI matching.
AITTA_API_KEY=
# Fallback live backend and evaluation. Featherless_AP_KEY is also accepted.
FEATHERLESS_API_KEY=
# Listen button. Voice, model and call budget are optional.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=
# SPEAK_MAX_CALLS=50
