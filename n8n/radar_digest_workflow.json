{
  "name": "Reuse Gate: radar digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
