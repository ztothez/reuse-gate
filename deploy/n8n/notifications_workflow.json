{
  "name": "Reuse Gate notifications",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "notify-hook",
      "name": "Reuse Gate Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "reuse-gate-notify",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "Reuse Gate webhook secret"
        }
      }
    },
    {
      "id": "notify-mail",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "Reuse Gate <agent@ztothez.com>",
        "toEmail": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE",
          "name": "Proton SMTP"
        }
      }
    },
    {
      "id": "notify-respond",
      "name": "Respond Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, id: $(\"Reuse Gate Event\").item.json.body.id } }}"
      }
    }
  ],
  "connections": {
    "Reuse Gate Event": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
